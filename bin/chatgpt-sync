#!/usr/bin/env python3
"""Keep a local, git-versioned copy of your ChatGPT conversations.

Subcommands:
  serve     Run the localhost listener the browser extension pushes to.
  import    Import an official ChatGPT data export (zip or unpacked folder).
  render    Re-render every stored conversation (after changing the format).
  status    Show the last sync and archive counts.

Raw conversation JSON in the data directory is the source of truth and is
committed to a local git repo there after each sync. Markdown (default) or Org
files are generated from it and can be rebuilt at any time with `render`.
ChatGPT pages that a conversation creates, edits or reads are stored and
rendered the same way, and each conversation's file links to them.

Settings come from ~/.config/chatgpt-sync/config.json (or the file named by
CHATGPT_SYNC_CONFIG). All keys are optional:
  format      "markdown" (default) or "org" (Org needs pandoc)
  output_dir  where rendered files go (default: <data_dir>/<format>)
  data_dir    raw JSON and index (default: data/ next to bin/)
  state_dir   heartbeat and pause file (default: ~/.local/state/chatgpt-sync)
"""

from __future__ import annotations

import argparse
import datetime as dt
import glob
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import threading
import time
import unicodedata
import zipfile
from concurrent.futures import ThreadPoolExecutor
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlsplit

# ----------------------------------------------------------------- config

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CONFIG_PATH = os.environ.get("CHATGPT_SYNC_CONFIG") or os.path.expanduser(
    "~/.config/chatgpt-sync/config.json")
FORMATS = {"markdown": ".md", "org": ".org"}
CONFIG_KEYS = {"format", "output_dir", "data_dir", "state_dir"}


def load_config(path: str) -> dict:
    if not os.path.exists(path):
        return {}
    with open(path, encoding="utf-8") as f:
        config = json.load(f)
    unknown = set(config) - CONFIG_KEYS
    if unknown:
        sys.exit(f"{path}: unknown setting(s) {sorted(unknown)}; known: {sorted(CONFIG_KEYS)}")
    if config.get("format", "markdown") not in FORMATS:
        sys.exit(f"{path}: format must be one of {sorted(FORMATS)}")
    return config


CONFIG = load_config(CONFIG_PATH)
FORMAT = CONFIG.get("format", "markdown")
DATA = os.path.expanduser(CONFIG.get("data_dir") or os.path.join(REPO, "data"))
OUTPUT = os.path.expanduser(CONFIG.get("output_dir") or os.path.join(DATA, FORMAT))
STATE_DIR = os.path.expanduser(CONFIG.get("state_dir") or "~/.local/state/chatgpt-sync")
RAW = os.path.join(DATA, "raw")
INDEX = os.path.join(DATA, "index.json")
DOCS_RAW = os.path.join(DATA, "documents")
DOCS_INDEX = os.path.join(DATA, "documents.json")
LAST_SYNC = os.path.join(STATE_DIR, "last-sync.json")
PAUSED = os.path.join(STATE_DIR, "paused")

PORT = 8765
# Fixed by the "key" in extension/manifest.json; only this extension may push.
EXTENSION_ORIGIN = "chrome-extension://peikpbjilajgjpmkipcbgkfamfpihhno"

LOCK = threading.Lock()

# The extension's code files, hashed the same way by codeHash() in
# extension/background.js. The extension reports the hash of the code it has
# loaded; comparing it with the files on disk shows a stale extension, which
# then reloads itself. Keep this list identical to CODE_FILES there.
EXTENSION_DIR = os.path.join(REPO, "extension")
EXTENSION_CODE_FILES = ["manifest.json", "background.js", "content.js", "popup.html", "popup.js"]


def extension_code_hash() -> str | None:
    """Hash of the extension code on disk, or None outside a repo checkout."""
    lines = []
    for name in EXTENSION_CODE_FILES:
        path = os.path.join(EXTENSION_DIR, name)
        if not os.path.exists(path):
            return None
        with open(path, "rb") as f:
            lines.append(f"{name}\n{hashlib.sha256(f.read()).hexdigest()}\n")
    return hashlib.sha256("".join(lines).encode()).hexdigest()


# ---------------------------------------------------------------- helpers

def to_epoch(value) -> float:
    """Normalize ChatGPT timestamps (epoch floats or ISO strings) to epoch."""
    if value is None:
        return 0.0
    if isinstance(value, (int, float)):
        return float(value)
    s = str(value).replace("Z", "+00:00")
    return dt.datetime.fromisoformat(s).timestamp()


def org_ts(epoch: float) -> str:
    return dt.datetime.fromtimestamp(epoch).strftime("[%Y-%m-%d %a %H:%M]")


def iso_ts(epoch: float) -> str:
    return dt.datetime.fromtimestamp(epoch).isoformat(timespec="seconds")


def write_atomic(path: str, text: str) -> None:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".tmp-")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, path)


def load_json_map(path: str) -> dict:
    if os.path.exists(path):
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    return {}


def write_json(path: str, data: dict) -> None:
    write_atomic(path, json.dumps(data, indent=1, sort_keys=True, ensure_ascii=False) + "\n")


def load_index() -> dict:
    return load_json_map(INDEX)


def save_index(index: dict) -> None:
    write_json(INDEX, index)


def load_documents() -> dict:
    return load_json_map(DOCS_INDEX)


def save_documents(docs: dict) -> None:
    write_json(DOCS_INDEX, docs)


def slugify(title: str) -> str:
    s = unicodedata.normalize("NFKD", title).encode("ascii", "ignore").decode()
    s = re.sub(r"[^a-zA-Z0-9]+", "-", s).strip("-").lower()
    return s[:60].rstrip("-") or "untitled"


def conv_id(conv: dict) -> str:
    return conv.get("conversation_id") or conv["id"]


def require_pandoc() -> None:
    if FORMAT == "org" and not shutil.which("pandoc"):
        sys.exit("format \"org\" needs pandoc on PATH (https://pandoc.org/installing.html)")


# --------------------------------------------------------- message content

CITATION_MARK = re.compile(".*?", re.S)


def apply_content_references(text: str, metadata: dict) -> str:
    """Replace ChatGPT's private-use citation markers with readable text."""
    refs = metadata.get("content_references") or []
    for ref in sorted(refs, key=lambda r: -len(r.get("matched_text") or "")):
        matched = ref.get("matched_text")
        if not matched:
            continue
        replacement = ref.get("alt") or ""
        if not replacement and ref.get("items"):
            links = [f"[{i.get('title') or i.get('url')}]({i['url']})"
                     for i in ref["items"] if i.get("url")]
            replacement = " (" + "; ".join(links) + ")" if links else ""
        text = text.replace(matched, replacement)
    return CITATION_MARK.sub("", text)


def fence(body: str, lang: str = "") -> str:
    ticks = "````" if "```" in body else "```"
    return f"{ticks}{lang}\n{body}\n{ticks}"


def message_markdown(msg: dict) -> str | None:
    """Return the markdown for one message, or None to omit it."""
    content = msg.get("content") or {}
    ctype = content.get("content_type")
    meta = msg.get("metadata") or {}
    role = (msg.get("author") or {}).get("role")

    if ctype == "text":
        text = "\n\n".join(p for p in content.get("parts") or [] if isinstance(p, str))
        if role == "assistant":
            text = apply_content_references(text, meta)
        return text if text.strip() else None
    if ctype == "multimodal_text":
        out = []
        for p in content.get("parts") or []:
            if isinstance(p, str):
                out.append(p)
            elif isinstance(p, dict):
                pt = p.get("content_type")
                if pt == "audio_transcription":
                    out.append(p.get("text", ""))
                elif pt == "image_asset_pointer":
                    out.append(f"[image: {p.get('asset_pointer', '')}]")
                else:
                    out.append(f"[{pt}]")
        text = "\n\n".join(x for x in out if x)
        return text if text.strip() else None
    if ctype == "code":
        lang = content.get("language") or ""
        if lang == "unknown":
            lang = ""
        return fence(content.get("text", ""), lang)
    if ctype == "execution_output":
        return fence(content.get("text", ""))
    if ctype == "thoughts":
        lines = []
        for t in content.get("thoughts") or []:
            if t.get("summary"):
                lines.append(f"**{t['summary']}**")
            if t.get("content"):
                lines.append(t["content"])
        return "\n\n".join(lines) or None
    if ctype in ("reasoning_recap", "user_editable_context", "model_editable_context"):
        return None
    if ctype == "tether_quote":
        return f"> {content.get('text', '')}\n\n— [{content.get('title', '')}]({content.get('url', '')})"
    if ctype in ("tether_browsing_display", "system_error"):
        text = content.get("result") or content.get("text") or ""
        return fence(text) if text.strip() else None
    if ctype == "sonic_webpage":
        return f"[{content.get('title', '')}]({content.get('url', '')})"
    return f"[unrendered content type: {ctype}]"


def heading_for(msg: dict) -> tuple:
    """Return (group key, heading text) used to merge consecutive turns."""
    author = msg.get("author") or {}
    role = author.get("role")
    ctype = (msg.get("content") or {}).get("content_type")
    if role == "user":
        return ("user", "User")
    if role == "tool":
        return ("tool", f"Tool output ({author.get('name') or 'tool'})")
    if ctype == "thoughts":
        return ("thoughts", "Reasoning")
    recipient = msg.get("recipient") or "all"
    if recipient != "all":
        return ("call", f"Tool call → {recipient}")
    return ("assistant", "ChatGPT")


def current_path(conv: dict) -> list:
    mapping = conv.get("mapping") or {}
    node_id = conv.get("current_node")
    path = []
    while node_id and node_id in mapping:
        node = mapping[node_id]
        if node.get("message"):
            path.append(node["message"])
        node_id = node.get("parent")
    return list(reversed(path))


def visible_blocks(conv: dict) -> list:
    """Return (group key, heading, epoch, markdown) for the rendered branch."""
    blocks = []
    for msg in current_path(conv):
        role = (msg.get("author") or {}).get("role")
        meta = msg.get("metadata") or {}
        if role == "system" or meta.get("is_visually_hidden_from_conversation"):
            continue
        md = message_markdown(msg)
        if md is None:
            continue
        key, head = heading_for(msg)
        blocks.append((key, head, msg.get("create_time"), md))
    return blocks


# ---------------------------------------------------------- markdown output

FENCE_OPEN = re.compile(r"^\s{0,3}(`{3,}|~{3,})")
ATX_HEADING = re.compile(r"^(#{1,6})(\s)")


def shift_headings(markdown: str, by: int) -> str:
    """Demote ATX headings outside code fences so they nest under turns."""
    out, fence_marker = [], None
    for line in markdown.split("\n"):
        m = FENCE_OPEN.match(line)
        if m:
            marker = m.group(1)
            if fence_marker is None:
                fence_marker = marker
            elif marker[0] == fence_marker[0] and len(marker) >= len(fence_marker):
                fence_marker = None
        elif fence_marker is None:
            line = ATX_HEADING.sub(lambda h: "#" * min(6, len(h.group(1)) + by) + h.group(2), line)
        out.append(line)
    return "\n".join(out)


def markdown_literal(text: str) -> str:
    """User turns are shown as typed; keep a leading # from becoming a heading."""
    return re.sub(r"^(\s{0,3})#", r"\1\\#", text, flags=re.M)


def markdown_link_text(text: str) -> str:
    return re.sub(r"([][])", r"\\\1", text)


def render_markdown(conv: dict, entry: dict, docs: dict) -> str:
    cid = conv_id(conv)
    front = {
        "title": entry["title"],
        "chatgpt_id": cid,
        "url": f"https://chatgpt.com/c/{cid}",
        "created": iso_ts(to_epoch(conv.get("create_time"))),
        "updated": iso_ts(entry["update_time"]),
        "model": conv.get("default_model_slug"),
        "archived": entry.get("is_archived") or None,
        "starred": entry.get("is_starred") or None,
        "gizmo": conv.get("gizmo_id"),
    }
    out = ["---"]
    out += [f"{k}: {json.dumps(v, ensure_ascii=False)}" for k, v in front.items() if v is not None]
    out += ["---", "", f"# {entry['title']}", ""]
    prev_key = None
    for key, head, created, md in visible_blocks(conv):
        if key != prev_key:
            stamp = f" · {dt.datetime.fromtimestamp(to_epoch(created)):%Y-%m-%d %H:%M}" if created else ""
            out += [f"## {head}{stamp}", ""]
            prev_key = key
        out += [markdown_literal(md) if key == "user" else shift_headings(md, 2), ""]
    links = document_links(entry, docs)
    if links:
        out += ["## Documents", ""]
        out += [f"- [{markdown_link_text(label)}]({target})" for target, label in links]
    return "\n".join(out).rstrip("\n") + "\n"


# --------------------------------------------------------------- org output

PANDOC_FROM = "markdown-smart-auto_identifiers+tex_math_single_backslash"
SEPARATOR = "CHATGPTSYNCSEPARATOR7F3A"


def pandoc(markdown: str, shift: int = 1) -> str:
    out = subprocess.run(
        ["pandoc", "-f", PANDOC_FROM, "-t", "org", "--wrap=preserve",
         f"--shift-heading-level-by={shift}"],
        input=markdown, capture_output=True, text=True, check=True)
    return out.stdout


def md_to_org_many(chunks: list) -> list:
    """Convert markdown chunks to Org in one pandoc call.

    Chunks are joined with a separator paragraph. If a chunk leaves a code
    fence open, the separator gets swallowed and the split count is wrong;
    then each chunk is converted on its own, which is slower but exact.
    """
    if not chunks:
        return []
    joined = f"\n\n{SEPARATOR}\n\n".join(chunks)
    parts = re.split(rf"^{SEPARATOR}$", pandoc(joined), flags=re.M)
    if len(parts) == len(chunks):
        return [p.strip("\n") for p in parts]
    return [pandoc(c).strip("\n") for c in chunks]


def org_literal(text: str) -> str:
    """User turns are shown verbatim, as ChatGPT displays them."""
    escaped = re.sub(r"^(\s*)([*]|#\+|,[*]|,#\+)", r"\1,\2", text, flags=re.M)
    return f"#+begin_example\n{escaped}\n#+end_example"


def render_org(conv: dict, entry: dict, docs: dict) -> str:
    blocks = visible_blocks(conv)
    converted = iter(md_to_org_many([b[3] for b in blocks if b[0] != "user"]))
    bodies = [org_literal(b[3]) if b[0] == "user" else next(converted) for b in blocks]
    cid = conv_id(conv)
    out = [":PROPERTIES:"]
    # An "org_id" set by hand in index.json keeps Org ID links to this chat
    # working across re-renders.
    if entry.get("org_id"):
        out.append(f":ID:       {entry['org_id']}")
    out += [
        f":CHATGPT_ID: {cid}",
        f":CHATGPT_URL: https://chatgpt.com/c/{cid}",
        f":CREATED: {org_ts(to_epoch(conv.get('create_time')))}",
        f":UPDATED: {org_ts(entry['update_time'])}",
    ]
    if conv.get("default_model_slug"):
        out.append(f":MODEL: {conv['default_model_slug']}")
    if entry.get("is_archived"):
        out.append(":ARCHIVED: t")
    if entry.get("is_starred"):
        out.append(":STARRED: t")
    if conv.get("gizmo_id"):
        out.append(f":GIZMO: {conv['gizmo_id']}")
    out += [":END:", f"#+title: {entry['title']}", ""]

    prev_key = None
    for (key, head, created, _), body in zip(blocks, bodies):
        if key != prev_key:
            stamp = f" {org_ts(to_epoch(created))}" if created else ""
            out += [f"* {head}{stamp}", ""]
            prev_key = key
        out += [body, ""]
    links = document_links(entry, docs)
    if links:
        out += ["* Documents", ""]
        out += [f"- [[{target if '://' in target else 'file:' + target}]"
                f"[{label.replace('[', '(').replace(']', ')')}]]" for target, label in links]
    return "\n".join(out).rstrip("\n") + "\n"


RENDERERS = {"markdown": render_markdown, "org": render_org}


def render(conv: dict, entry: dict, docs: dict) -> str:
    return RENDERERS[FORMAT](conv, entry, docs)


def output_relpath(conv: dict, title: str) -> str:
    created = dt.datetime.fromtimestamp(to_epoch(conv.get("create_time")))
    cid = conv_id(conv)
    return os.path.join(created.strftime("%Y"),
                        # The ID's first 8 hex digits are its creation second,
                        # so add its random tail to keep same-second chats apart.
                        f"{created:%Y-%m-%d}--{slugify(title)}--{cid[:8]}{cid[-4:]}"
                        + FORMATS[FORMAT])


# -------------------------------------------------------------- documents
#
# A ChatGPT page (a "ChatGPT Space" document) lives outside the conversation
# that creates or edits it: the conversation holds only the tool calls and the
# page's link, and the page can change after the chat ends. So every page a
# stored chat refers to is stored on its own (documents/, documents.json),
# rendered to its own file, linked from the chat's file, and checked for
# changes on every sync.

PAGE_ID = re.compile(r"\bpage_[0-9a-f]{32}\b")
# ChatGPT keeps a deleted page in its trash, restorable, for this many days.
# A page deleted or trashed answers 404 either way, so one that has answered
# 404 for longer is gone for good and is no longer checked.
TRASH_DAYS = 30


def page_url(pid: str) -> str:
    return f"https://chatgpt.com/space/{pid}"


def document_refs(conv: dict) -> list:
    """IDs of the ChatGPT pages a conversation refers to, on any branch.

    A page appears as a tool call argument (read_page), in a tool result's
    resource list (create_page) and as a chatgpt.com/space/<id> link.
    """
    return sorted(set(PAGE_ID.findall(json.dumps(conv))))


def page_version(page: dict) -> dict:
    """The page metadata fields that change when the page does.

    The extension compares these with a page's current metadata to decide
    whether to fetch it. An edit to a page's text or title advances
    current_sequence but leaves updated_at alone. The sequence recorded is the
    one the fetched content reflects, so content that trailed the metadata is
    fetched again on the next sync.
    """
    meta = page.get("metadata") or {}
    content = page.get("content") or {}
    return {"current_sequence": content.get("through_sequence", meta.get("current_sequence")),
            "updated_at": meta.get("updated_at"),
            "deleted_at": meta.get("deleted_at")}


def page_updated(page: dict) -> float:
    """When the page last changed: each block records its own last edit."""
    blocks = (page.get("content") or {}).get("blocks") or []
    return max([to_epoch((page.get("metadata") or {}).get("updated_at"))]
               + [to_epoch((b.get("last_modified") or {}).get("changed_at")) for b in blocks])


def page_markdown(page: dict) -> str:
    md = (page.get("content") or {}).get("markdown")
    if isinstance(md, str):
        return md
    return f"[unrendered page layout: {(page.get('metadata') or {}).get('layout')}]"


def document_relpath(pid: str, title: str, created: float) -> str:
    when = dt.datetime.fromtimestamp(created)
    return os.path.join("documents", when.strftime("%Y"),
                        f"{when:%Y-%m-%d}--{slugify(title)}--{pid[-12:]}" + FORMATS[FORMAT])


def document_links(entry: dict, docs: dict) -> list:
    """(target, label) for each page a conversation refers to.

    A stored page is linked by its file's path relative to the conversation's
    file; one not stored (yet) by its chatgpt.com URL.
    """
    links = []
    for pid in entry.get("documents") or []:
        doc = docs.get(pid) or {}
        if doc.get("file"):
            target = os.path.relpath(doc["file"], os.path.dirname(entry["file"]))
            links.append((target.replace(os.sep, "/"), doc["title"]))
        else:
            links.append((page_url(pid), pid))
    return links


def render_document_markdown(page: dict, entry: dict) -> str:
    pid = page["metadata"]["page_id"]
    front = {"title": entry["title"], "chatgpt_page_id": pid, "url": page_url(pid),
             "created": iso_ts(entry["create_time"]), "updated": iso_ts(entry["update_time"])}
    out = ["---"]
    out += [f"{k}: {json.dumps(v, ensure_ascii=False)}" for k, v in front.items()]
    out += ["---", "", f"# {entry['title']}", "", shift_headings(page_markdown(page), 1)]
    return "\n".join(out).rstrip("\n") + "\n"


def render_document_org(page: dict, entry: dict) -> str:
    pid = page["metadata"]["page_id"]
    out = [":PROPERTIES:"]
    if entry.get("org_id"):
        out.append(f":ID:       {entry['org_id']}")
    out += [f":CHATGPT_PAGE_ID: {pid}",
            f":CHATGPT_URL: {page_url(pid)}",
            f":CREATED: {org_ts(entry['create_time'])}",
            f":UPDATED: {org_ts(entry['update_time'])}",
            ":END:", f"#+title: {entry['title']}", "",
            pandoc(page_markdown(page), shift=0)]
    return "\n".join(out).rstrip("\n") + "\n"


DOCUMENT_RENDERERS = {"markdown": render_document_markdown, "org": render_document_org}


def rerender_conversations(pid: str, index: dict, docs: dict) -> None:
    """Rewrite the files of the conversations that link to a page."""
    for cid, entry in index.items():
        if pid in (entry.get("documents") or []):
            with open(os.path.join(RAW, f"{cid}.json"), encoding="utf-8") as f:
                conv = json.load(f)
            write_atomic(os.path.join(OUTPUT, entry["file"]), render(conv, entry, docs))


def store_document(page: dict, docs: dict, index: dict, force: bool = False) -> bool:
    """Save one page's raw JSON and rendered file. Return True if written."""
    meta = page["metadata"]
    pid = meta["page_id"]
    if not PAGE_ID.fullmatch(pid):
        raise ValueError(f"not a page ID: {pid!r}")
    old = docs.get(pid) or {}
    version = page_version(page)
    if old.get("version") == version and not old.get("missing_since") and not force:
        return False
    title = meta.get("title") or "Untitled"
    created = to_epoch(meta.get("created_at"))
    entry = {"kind": "page", "title": title, "create_time": created,
             "update_time": page_updated(page), "version": version,
             "file": document_relpath(pid, title, created)}
    if old.get("org_id"):
        entry["org_id"] = old["org_id"]
    write_json(os.path.join(DOCS_RAW, f"{pid}.json"), page)
    write_atomic(os.path.join(OUTPUT, entry["file"]), DOCUMENT_RENDERERS[FORMAT](page, entry))
    if old.get("file") and old["file"] != entry["file"]:
        stale = os.path.join(OUTPUT, old["file"])
        if os.path.exists(stale):
            os.remove(stale)  # renamed page; documents/ history keeps the old version
    docs[pid] = entry
    # Links show the page's title and path, so a first fetch or a rename
    # changes the files of the chats that link to it.
    if (old.get("file"), old.get("title")) != (entry["file"], entry["title"]):
        rerender_conversations(pid, index, docs)
    return True


def mark_missing(pid: str, docs: dict, now: float) -> None:
    """Record that a page answered 404; its local copy is kept."""
    if not PAGE_ID.fullmatch(pid):
        raise ValueError(f"not a page ID: {pid!r}")
    docs.setdefault(pid, {"kind": "page"}).setdefault("missing_since", now)


def documents_to_check(index: dict, docs: dict, now: float) -> dict:
    """The pages the extension should check, with their stored version.

    That is every page a stored chat refers to, except one that has answered
    404 for longer than ChatGPT keeps deleted pages. A page without a version
    is fetched in full: one never fetched, or one that answered 404 and may
    come back from the trash unchanged.
    """
    refs = {pid for entry in index.values() for pid in entry.get("documents") or []}
    out = {}
    for pid in sorted(refs | set(docs)):
        doc = docs.get(pid) or {}
        missing = doc.get("missing_since")
        if missing and now - missing > TRASH_DAYS * 86400:
            continue
        out[pid] = {"kind": "page", "version": None if missing else doc.get("version")}
    return out


# ------------------------------------------------------------------ store

def ensure_data_repo() -> None:
    """Create the data directory as a local git repo on first use."""
    os.makedirs(RAW, exist_ok=True)
    if not os.path.isdir(os.path.join(DATA, ".git")):
        subprocess.run(["git", "init", "-q", DATA], check=True)
    ignore = os.path.join(DATA, ".gitignore")
    if not os.path.exists(ignore):
        # Rendered output is regenerated from raw/, so only raw/ is versioned.
        # No trailing slash: the output folder may be a symlink.
        write_atomic(ignore, "".join(f"/{f}\n" for f in FORMATS))


def store(conv: dict, meta: dict | None, index: dict, docs: dict, force: bool = False) -> bool:
    """Save one conversation's raw JSON and rendered file. Return True if written.

    docs (the documents index) is only read, to link the pages the chat
    refers to.
    """
    cid = conv_id(conv)
    meta = meta or {}
    update = max(to_epoch(conv.get("update_time")), to_epoch(meta.get("update_time")))
    old = index.get(cid)
    if old and old["update_time"] >= update and not force:
        return False

    def flag(name):
        # Freshest source first: the listing sent with this sync, then the
        # index (kept current by update_flags), then the raw JSON, whose copy
        # dates from the last fetch and misses archive/star-only changes.
        if name in meta:
            return bool(meta[name])
        if old and name in old:
            return bool(old[name])
        return bool(conv.get(name, False))

    title = conv.get("title") or meta.get("title") or "Untitled"
    entry = {
        "title": title,
        "create_time": to_epoch(conv.get("create_time")),
        "update_time": update,
        "is_archived": flag("is_archived"),
        "is_starred": flag("is_starred"),
        "gizmo_id": conv.get("gizmo_id"),
        "file": output_relpath(conv, title),
        "documents": document_refs(conv),
    }
    if old and old.get("org_id"):
        entry["org_id"] = old["org_id"]
    write_json(os.path.join(RAW, f"{cid}.json"), conv)
    write_atomic(os.path.join(OUTPUT, entry["file"]), render(conv, entry, docs))
    if old and old.get("file") and old["file"] != entry["file"]:
        stale = os.path.join(OUTPUT, old["file"])
        if os.path.exists(stale):
            os.remove(stale)  # renamed chat; raw/ history keeps the old version
    index[cid] = entry
    return True


def update_flags(listing: list, index: dict, docs: dict) -> list:
    """Apply archived/starred changes that don't bump update_time."""
    changed = []
    for item in listing:
        entry = index.get(item.get("id"))
        if not entry:
            continue
        flags = {"is_archived": bool(item.get("is_archived")),
                 "is_starred": bool(item.get("is_starred"))}
        if any(entry.get(k) != v for k, v in flags.items()):
            entry.update(flags)
            changed.append(item["id"])
    for cid in changed:
        with open(os.path.join(RAW, f"{cid}.json"), encoding="utf-8") as f:
            conv = json.load(f)
        write_atomic(os.path.join(OUTPUT, index[cid]["file"]), render(conv, index[cid], docs))
    return changed


def git_commit(message: str) -> str | None:
    # git refuses a pathspec that matches nothing, as documents/ does until
    # the first page is stored.
    paths = [p for p in ("raw", "index.json", "documents", "documents.json")
             if os.path.exists(os.path.join(DATA, p))]
    subprocess.run(["git", "-C", DATA, "add", "-A", *paths], check=True)
    staged = subprocess.run(["git", "-C", DATA, "diff", "--cached", "--quiet"])
    if staged.returncode == 0:
        return None
    # The pathspec keeps any other staged work out of sync commits.
    subprocess.run(["git", "-C", DATA, "commit", "-q", "-m", message, "--", *paths], check=True)
    return subprocess.run(["git", "-C", DATA, "rev-parse", "--short", "HEAD"],
                          capture_output=True, text=True, check=True).stdout.strip()


# ----------------------------------------------------------------- server

class Handler(BaseHTTPRequestHandler):
    server_version = "chatgpt-sync"

    def log_message(self, fmt, *args):
        sys.stderr.write("%s %s\n" % (dt.datetime.now().isoformat(timespec="seconds"), fmt % args))

    def _reply(self, code: int, payload: dict) -> None:
        body = json.dumps(payload).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _authorized(self) -> bool:
        if os.path.exists(PAUSED):
            self._reply(503, {"error": f"paused: remove {PAUSED} to resume"})
            return False
        origin = self.headers.get("Origin")
        if origin == EXTENSION_ORIGIN:
            return True
        # Chrome omits Origin on the extension's GETs. Allowing that is safe:
        # a web page's Origin-less request (no-cors) gets an opaque response
        # it can't read, and GET changes nothing.
        if origin is None and self.command == "GET":
            return True
        self.log_message("rejected %s %s from origin %r", self.command, self.path, origin)
        self._reply(403, {"error": "forbidden origin"})
        return False

    def do_GET(self):
        if self.path == "/health":
            return self._reply(200, {"ok": True})
        if not self._authorized():
            return
        url = urlsplit(self.path)
        if url.path == "/state":
            query = parse_qs(url.query)
            loaded = (query.get("code") or [None])[0]
            disk = extension_code_hash()
            if loaded and disk and loaded != disk:
                self.log_message("extension %s runs stale code (loaded %s, disk %s)",
                                 (query.get("v") or ["?"])[0], loaded[:12], disk[:12])
            with LOCK:
                index = load_index()
            return self._reply(200, {"ids": {k: v["update_time"] for k, v in index.items()},
                                     "extension_code": disk})
        if url.path == "/documents":
            with LOCK:
                checks = documents_to_check(load_index(), load_documents(), time.time())
            return self._reply(200, {"documents": checks})
        self._reply(404, {"error": "not found"})

    def do_POST(self):
        if not self._authorized():
            return
        length = int(self.headers.get("Content-Length") or 0)
        payload = json.loads(self.rfile.read(length) or b"{}")
        try:
            if self.path == "/conversations":
                with LOCK:
                    index = load_index()
                    docs = load_documents()
                    written = [conv_id(it["conversation"]) for it in payload["items"]
                               if store(it["conversation"], it.get("meta"), index, docs)]
                    save_index(index)
                return self._reply(200, {"written": len(written)})
            if self.path == "/documents":
                with LOCK:
                    index = load_index()
                    docs = load_documents()
                    written = [p for p in payload.get("pages") or []
                               if store_document(p, docs, index)]
                    for pid in payload.get("missing") or []:
                        mark_missing(pid, docs, time.time())
                    save_documents(docs)
                return self._reply(200, {"written": len(written)})
            if self.path == "/sync-done":
                with LOCK:
                    index = load_index()
                    flagged = update_flags(payload.get("listing") or [], index, load_documents())
                    save_index(index)
                    s = payload.get("summary") or {}
                    commit = git_commit(
                        f"sync: {s.get('fetched', 0)} fetched, {len(flagged)} flag changes, "
                        f"{s.get('documents', 0)} documents")
                record = {"at": dt.datetime.now().isoformat(timespec="seconds"),
                          "summary": s, "flag_changes": len(flagged),
                          "commit": commit, "errors": payload.get("errors") or [],
                          "extension": payload.get("extension")}
                write_atomic(LAST_SYNC, json.dumps(record, indent=1) + "\n")
                return self._reply(200, {"commit": commit})
        except Exception as e:  # report to the extension, which shows a badge
            self.log_message("error on %s: %r", self.path, e)
            return self._reply(500, {"error": repr(e)})
        self._reply(404, {"error": "not found"})


def make_server(port: int) -> ThreadingHTTPServer:
    require_pandoc()
    ensure_data_repo()
    os.makedirs(STATE_DIR, exist_ok=True)
    return ThreadingHTTPServer(("127.0.0.1", port), Handler)


def cmd_serve(args) -> None:
    httpd = make_server(args.port)
    print(f"listening on 127.0.0.1:{httpd.server_port}; writing {FORMAT} to {OUTPUT}",
          file=sys.stderr, flush=True)
    httpd.serve_forever()


# ------------------------------------------------------------ import/render

def read_export(path: str) -> list:
    convs = []
    if zipfile.is_zipfile(path):
        with zipfile.ZipFile(path) as z:
            for name in sorted(z.namelist()):
                if re.fullmatch(r"(.*/)?conversations(-\d+)?\.json", name):
                    convs += json.loads(z.read(name))
    else:
        for name in sorted(glob.glob(os.path.join(path, "conversations*.json"))):
            with open(name, encoding="utf-8") as f:
                convs += json.load(f)
    if not convs:
        sys.exit(f"no conversations*.json found in {path}")
    return convs


def parallel_store(convs: list, index: dict, docs: dict, force: bool) -> int:
    # Rendering dominates; index updates happen on the main thread afterwards.
    def work(conv):
        local = {conv_id(conv): index[conv_id(conv)]} if conv_id(conv) in index else {}
        return local if store(conv, None, local, docs, force) else None
    n = 0
    with ThreadPoolExecutor(max_workers=os.cpu_count() or 4) as pool:
        for result in pool.map(work, convs):
            if result:
                index.update(result)
                n += 1
    return n


def cmd_import(args) -> None:
    require_pandoc()
    ensure_data_repo()
    convs = read_export(args.path)
    with LOCK:
        index = load_index()
        n = parallel_store(convs, index, load_documents(), force=False)
        save_index(index)
        commit = git_commit(f"import: {n} of {len(convs)} conversations from official export")
    print(f"{len(convs)} in export, {n} new or newer, commit {commit}")


def cmd_render(args) -> None:
    require_pandoc()
    with LOCK:
        index = load_index()
        docs = load_documents()
        pages = 0
        for pid in docs:
            path = os.path.join(DOCS_RAW, f"{pid}.json")
            if os.path.exists(path):  # not so for a page that was never fetched
                with open(path, encoding="utf-8") as f:
                    pages += store_document(json.load(f), docs, index, force=True)
        save_documents(docs)
        convs = []
        for cid in index:
            with open(os.path.join(RAW, f"{cid}.json"), encoding="utf-8") as f:
                convs.append(json.load(f))
        n = parallel_store(convs, index, docs, force=True)
        save_index(index)
    print(f"re-rendered {n} conversations and {pages} documents as {FORMAT} in {OUTPUT}")


def cmd_status(args) -> None:
    index = load_index()
    print(f"{len(index)} conversations ({sum(e['is_archived'] for e in index.values())} archived), "
          f"{len(load_documents())} documents")
    print(f"format {FORMAT}, data {DATA}, output {OUTPUT}")
    if os.path.exists(LAST_SYNC):
        with open(LAST_SYNC) as f:
            print("last sync:", f.read().strip())
    else:
        print("no sync recorded yet")


def main() -> None:
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("serve")
    s.add_argument("--port", type=int, default=PORT)
    s.set_defaults(func=cmd_serve)
    i = sub.add_parser("import")
    i.add_argument("path", help="export .zip or unpacked export folder")
    i.set_defaults(func=cmd_import)
    sub.add_parser("render").set_defaults(func=cmd_render)
    sub.add_parser("status").set_defaults(func=cmd_status)
    args = p.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
